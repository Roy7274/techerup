# 生产环境配置示例
NODE_ENV=production

# 数据库配置
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/teacherup?schema=public

# JWT 配置
JWT_SECRET=my-super-secret-key-2024-production-change-this-in-production
JWT_EXPIRES_IN=7d

# 服务端口
PORT=3001

# 前端地址
FRONTEND_URL=http://localhost:3000

# 前端配置
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_NAME=学与思教育
